{
  "name": "foodflow",
  "version": "1.0.0",
  "description": "FoodFlow – Modern food ordering web application deployed on AWS ECS via CodePipeline",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build": "echo 'Static site – no build step required' && exit 0",
    "lint": "eslint src/**/*.js",
    "test": "echo 'No tests configured yet' && exit 0",
    "docker:build": "docker build -t foodflow:latest .",
    "docker:run": "docker run -p 8080:80 --name foodflow foodflow:latest",
    "docker:stop": "docker stop foodflow && docker rm foodflow",
    "docker:compose": "docker-compose up --build -d",
    "docker:down": "docker-compose down"
  },
  "keywords": [
    "foodflow",
    "food-ordering",
    "aws",
    "ecs",
    "docker",
    "nginx"
  ],
  "author": "FoodFlow Team",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "compression": "^1.7.4",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "eslint": "^8.56.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.0.0"
  }
}
