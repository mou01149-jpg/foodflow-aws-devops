# ─────────────────────────────────────────────────────────────────────────────
# FoodFlow – Environment Variables
# Copy this file to .env and fill in your real values.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# Application
NODE_ENV=development
PORT=3000
APP_NAME=FoodFlow

# AWS
AWS_DEFAULT_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012
ECR_REPO_NAME=foodflow

# Database (future use)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=foodflow
# DB_USER=foodflow_user
# DB_PASSWORD=supersecret

# Secrets Manager (future use)
# SECRET_ARN=arn:aws:secretsmanager:us-east-1:123456789012:secret:foodflow/db
